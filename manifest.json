{
  "name": "Gatefold Reader",
  "short_name": "Gatefold",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "background_color": "#0B0D18",
  "theme_color": "#0B0D18",
  "orientation": "any",
  "description": "A foldable-screen EPUB and document reader with realistic page turns.",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
