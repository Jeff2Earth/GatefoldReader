{
  "name": "Gatefold Reader",
  "short_name": "Gatefold",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#0B0D18",
  "theme_color": "#0B0D18",
  "orientation": "any",
  "description": "A foldable-screen EPUB and document reader with realistic page turns.",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-book",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": [
            ".epub",
            "application/epub+zip",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
